# 依赖（本项目零依赖，留作兜底）
node_modules/

# 运行时临时文件
server/data/db.json.tmp
server/data/*.bak
*.log
npm-debug.log*

# 环境变量 / 密钥
.env
.env.*
!.env.example

# 本机后台登录凭据（scrypt 哈希，由 node server/setpass.js 生成本地文件）
server/data/admin.local.json

# 静态导出产物（由 CI 现场生成后直接发布，不入库）
dist/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
